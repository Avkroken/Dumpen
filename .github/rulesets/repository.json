{
  "name": "required-ci",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          { "context": "build (18.x)" },
          { "context": "build (20.x)" },
          { "context": "build (22.x)" },
          { "context": "dependency-review" }
        ]
      }
    }
  ]
}
